# Copy to .env. Only the API key is required; the values below are the defaults.

# The key from the assignment brief. Do not commit it.
UPSTREAM_API_KEY=

PORT=3000
LOG_LEVEL=info
UPSTREAM_BASE_URL=https://api.heyering.com

MAX_RECORDS_PER_REQUEST=5000
HEARTBEAT_INTERVAL_MS=5000
SHUTDOWN_GRACE_MS=30000

ENRICHMENT_TIMEOUT_MS=5000
ENRICHMENT_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000

ANALYTICS_BATCH_SIZE=20
ANALYTICS_INTERVAL_MS=10500
ANALYTICS_TIMEOUT_MS=10000
ANALYTICS_MAX_ATTEMPTS=3
