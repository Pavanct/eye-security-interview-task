{
  "name": "eye-security-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "CSV ingestion CLI and enrichment/analytics API for malicious activity logs",
  "type": "module",
  "engines": {
    "node": "^24 || >=26"
  },
  "scripts": {
    "api": "tsx --env-file-if-exists=.env src/api/main.ts",
    "cli": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.14",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
